#!/bin/bash
###############################################################################
#  🔬 Инженерный калькулятор - Скрипт запуска (macOS: двойной клик в Finder)
#  Запускает server.py: он раздаёт калькулятор и сам открывает его в браузере.
#  Порт можно указать аргументом: ./start.command 8081
###############################################################################

# Цвета для терминала
RED='\033[0;31m'
NC='\033[0m' # No Color

# Переходим в папку проекта: двойной клик запускает скрипт из домашней папки
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR" || exit 1

# Проверяем наличие Python
if ! command -v python3 &> /dev/null; then
    echo ""
    echo -e "${RED}❌ Ошибка: Python3 не найден!${NC}"
    echo ""
    echo "  Установите Python3: https://www.python.org/downloads/"
    echo "  или: brew install python3"
    echo ""
    exit 1
fi

# Порт (можно переопределить аргументом). Занят ли он — проверит server.py;
# чужие программы на этом порту скрипт не трогает
PORT="${1:-8080}"

# exec: сервер занимает это окно терминала, Ctrl+C останавливает его сразу
exec python3 "$SCRIPT_DIR/server.py" "$PORT"
